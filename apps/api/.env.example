# Postgres from docker-compose.yml at the repo root.
DATABASE_URL="postgresql://arrowfin:arrowfin@localhost:5435/arrowfin?schema=public"

# Dev-only secret. In production this comes from a secrets manager and rotates.
JWT_SECRET="dev-only-not-a-production-secret"
JWT_TTL="1h"

# The dataset is frozen at its cut. The domain never calls new Date() - "now" is injected,
# which is what makes the snapshot deterministic and testable.
NOW_ISO="2026-08-25T14:30:00Z"

# Gates the /dev/fills simulator. The module is not even registered unless BOTH
# NODE_ENV !== production AND DEV_TOOLS === on.
NODE_ENV="development"
DEV_TOOLS="on"

PORT=3001
CORS_ORIGIN="http://localhost:3000"
